# system
alias seeu='systemctl --user poweroff'
alias again='systemctl --user reboot'
alias scu='systemctl --user'
alias jcu='journalctl --user'
alias whichcmd='ps -o cmd -p'
alias ckproxy='env | grep -i proxy'

# ls
alias ls='ls --color=auto'
alias ll='ls -ahlF'
alias la='ls -A'
alias l='ls -CF'

# usual
alias gpu='nvidia-smi'
alias proxyon='export http_proxy=http://127.0.0.1:51847 \
https_proxy=http://127.0.0.1:51847 \
all_proxy=socks5://127.0.0.1:51848 \
HTTP_PROXY=http://127.0.0.1:51847 \
HTTPS_PROXY=http://127.0.0.1:51847 \
ALL_PROXY=socks5://127.0.0.1:51848 \
no_proxy="localhost,127.0.0.1" \
NO_PROXY="localhost,127.0.0.1"'
alias proxyoff='unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY no_proxy NO_PROXY'
