// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  //helix
  {
    "context": "Editor && vim_mode == helix_normal",
    "bindings": {
      "alt-j": ["editor::MoveDownByLines", { "lines": 13 }],
      "alt-k": ["editor::MoveUpByLines", { "lines": 13 }],
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j j": "vim::SwitchToHelixNormalMode",
      "tab": "editor::MoveToEndOfLargerSyntaxNode",
      "shift-tab": "editor::Tab",
    },
  },
  {
    "context": "(vim_mode == helix_normal || vim_mode == helix_select) && !menu",
    "bindings": {
      // Helix Space mode
      "space a": "editor::ToggleCodeActions",
      "space d": "diagnostics::DeployCurrentFile",
      "space shift-d": "diagnostics::Deploy"
    }
  },
  // basic
  {
    "context": "Workspace",
    "bindings": {
      "shift shift": "text_finder::Toggle"
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "~ ~": "workspace::OpenInTerminal",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "alt-j": "project_panel::ScrollDown",
      "alt-k": "project_panel::ScrollUp",
      "g e": "menu::SelectLast"
    },
  },
  {
    "bindings": {
      "alt-shift-o": [
        "projects::OpenRemote",
        { "from_existing_connection": false }
      ]
    }
  }
]
