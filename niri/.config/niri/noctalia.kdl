layout {

    focus-ring {
        active-color   "#ffb68c"
        inactive-color "#19120e"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb68c"
        inactive-color "#19120e"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#ffb68c"
        inactive-color "#833f0e"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb68c80"
    }
}

recent-windows {
    highlight {
        active-color "#ffb68c"
        urgent-color "#ffb4ab"
    }
}
